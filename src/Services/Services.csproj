<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><ProjectReference Include="../Persistence/Persistence.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="riven-data.json" LogicalName="WarframeCompanion.Services.riven-data.json" /></ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="../Native/build/$(Configuration)/warframe_native.dll" Link="warframe_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="../Native/build/libwarframe_native.so" Link="libwarframe_native.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
</Project>
